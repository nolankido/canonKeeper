# --- Gemini (default) --------------------------------------------------------------------
# Free key, no card: https://aistudio.google.com/apikey
# Free tier may use prompts to improve Google's products -> public-domain corpora only.
GEMINI_API_KEY=
CANONKEEPER_PROVIDER=gemini
# CANONKEEPER_EXTRACT_MODEL=gemini-3.8-flash
# CANONKEEPER_ADJUDICATE_MODEL=gemini-3.8-flash      # gemini-4-argon once billing is on
# CANONKEEPER_REQUESTS_PER_MINUTE=9                   # free tier is ~10 RPM on Flash models

# --- Local / open-weights (Ollama, LM Studio, vLLM, Baseten, Modal, Fireworks) ------------
# CANONKEEPER_PROVIDER=openweights
# CANONKEEPER_OPENWEIGHTS_BASE_URL=http://localhost:11434/v1     # Ollama
# CANONKEEPER_OPENWEIGHTS_BASE_URL=http://localhost:1234/v1      # LM Studio
# CANONKEEPER_OPENWEIGHTS_API_KEY=
# CANONKEEPER_EXTRACT_MODEL=qwen3:14b
# CANONKEEPER_ADJUDICATE_MODEL=qwen3:32b

# --- Meta Model API (requires billing) ----------------------------------------------------
# CANONKEEPER_PROVIDER=meta
# MODEL_API_KEY=

# --- Budgets -----------------------------------------------------------------------------
# CANONKEEPER_EXTRACT_CHUNK_TOKENS=6000
# CANONKEEPER_ADJUDICATE_CONTEXT_TOKENS=900000   # lower to ~150000 while iterating
# CANONKEEPER_ADJUDICATE_BATCH_SIZE=8
# CANONKEEPER_MAX_CANDIDATES_PER_RUN=200
# CANONKEEPER_MAX_RETRIES=6

# --- Preflight (PayPal) ----------------------------------------------------------------
# Sandbox app credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Leave unset for demo mode (payments simulated in-process).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox            # fake | sandbox | live
# PREFLIGHT_PUBLIC_URL=http://127.0.0.1:8787   # where PayPal sends the buyer back
