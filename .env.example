# Meta Model API key — create one at https://dev.meta.ai
MODEL_API_KEY=

# Provider: meta | openweights | mock
CANONKEEPER_PROVIDER=meta

# Models (defaults shown; IDs per https://dev.meta.ai/docs/overview)
CANONKEEPER_EXTRACT_MODEL=muse-spark-1.3
CANONKEEPER_ADJUDICATE_MODEL=muse-wonder-1.0
CANONKEEPER_IMAGE_MODEL=muse-image-1.0

# Open-weights mode (Baseten / Modal / Fireworks / vLLM — any OpenAI-compatible host)
# CANONKEEPER_OPENWEIGHTS_BASE_URL=https://.../v1
# CANONKEEPER_OPENWEIGHTS_API_KEY=
# CANONKEEPER_OPENWEIGHTS_MODEL=muse-spark-open

# Budgets
# CANONKEEPER_EXTRACT_CHUNK_TOKENS=6000
# CANONKEEPER_ADJUDICATE_CONTEXT_TOKENS=900000   # lower to ~150000 while iterating
# CANONKEEPER_ADJUDICATE_BATCH_SIZE=8
# CANONKEEPER_MAX_CANDIDATES_PER_RUN=200
